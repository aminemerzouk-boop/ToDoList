<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="amine.todolist.controller.ToDoController">
    <padding>
      <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
   </padding>
   <children>
      <HBox spacing="10.0">
         <children>
            <TextField fx:id="taskInput" onAction="#handleAddTask" promptText="Enter a new task..." HBox.hgrow="ALWAYS" />
            <Button fx:id="addButton" onAction="#handleAddTask" text="Add" />
         </children>
      </HBox>
      <ListView fx:id="taskListView" VBox.vgrow="ALWAYS" />
      <Button fx:id="deleteButton" onAction="#handleDeleteTask" text="Delete Selected" />
   </children>
</VBox>
